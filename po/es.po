#: lib/driveutility.py:512
#, python-brace-format
msgid ""
"The device <b>{device}</b> is currently mounted and in use.\n"
"\n"
"Performing '<b>{operation}</b>' operation on a mounted device can result in:\n"
"  • Data loss\n"
"  • System instability\n"
"  • File system corruption\n"
"\n"
"Are you sure you want to continue?"
msgstr ""
"El dispositivo <b>{device}</b> está actualmente montado y en uso.\n"
"\n"
"Realizar la operación '<b>{operation}</b>' en un dispositivo montado puede resultar en:\n"
"  • Pérdida de datos\n"
"  • Inestabilidad del sistema\n"
"  • Corrupción del sistema de archivos\n"
"\n"
"¿Está seguro de que desea continuar?"

#: lib/driveutility.py:527
msgid "_Cancel"
msgstr "_Cancelar"

#: lib/driveutility.py:529
msgid "C_ontinue"
msgstr "C_ontinuar"

#: lib/driveutility.py:774
msgid "Uses the drive controller to securely erase the drive without a full host-side overwrite."
msgstr "Utiliza el controlador de la unidad para borrar de forma segura sin sobrescribir completamente desde el host."

#: lib/driveutility.py:775
msgid "Discards all blocks quickly without overwriting the SSD. Use Secure erase when data must be unrecoverable."
msgstr "Descarta todos los bloques rápidamente sin sobrescribir el SSD. Utilice Borrado seguro cuando los datos deban ser irrecuperables."

#: lib/driveutility.py:776
msgid "Overwrites the selected area with zeros. This is suitable for hard disks but causes unnecessary SSD writes."
msgstr "Sobrescribe el área seleccionada con ceros. Es adecuado para discos duros, pero genera escrituras innecesarias en SSD."

#: lib/driveutility.py:777
msgid "Overwrites the selected area with random data. Multiple passes are normally unnecessary on modern drives."
msgstr "Sobrescribe el área seleccionada con datos aleatorios. Normalmente, no son necesarias múltiples pasadas en unidades modernas."

