#: lib/driveutility.py:512
#, python-brace-format
msgid ""
"The device <b>{device}</b> is currently mounted and in use.\n"
"\n"
"Performing '<b>{operation}</b>' operation on a mounted device can result in:\n"
"  • Data loss\n"
"  • System instability\n"
"  • File system corruption\n"
"\n"
"Are you sure you want to continue?"
msgstr ""
"Le périphérique <b>{device}</b> est actuellement monté et utilisé.\n"
"\n"
"Effectuer l’opération « <b>{operation}</b> » sur un périphérique monté peut entraîner :\n"
"  • Perte de données\n"
"  • Instabilité du système\n"
"  • Corruption du système de fichiers\n"
"\n"
"Voulez-vous vraiment continuer ?"

#: lib/driveutility.py:527
msgid "_Cancel"
msgstr "_Annuler"

#: lib/driveutility.py:529
msgid "C_ontinue"
msgstr "C_ontinuer"

#: lib/driveutility.py:774
msgid "Uses the drive controller to securely erase the drive without a full host-side overwrite."
msgstr "Utilise le contrôleur du disque pour effacer le disque de façon sécurisée sans réécriture complète côté hôte."

#: lib/driveutility.py:775
msgid "Discards all blocks quickly without overwriting the SSD. Use Secure erase when data must be unrecoverable."
msgstr "Supprime rapidement tous les blocs sans réécrire le SSD. Utilisez l'effacement sécurisé si les données doivent être irrécupérables."

#: lib/driveutility.py:776
msgid "Overwrites the selected area with zeros. This is suitable for hard disks but causes unnecessary SSD writes."
msgstr "Écrase la zone sélectionnée avec des zéros. Convient aux disques durs, mais provoque des écritures inutiles sur les SSD."

#: lib/driveutility.py:777
msgid "Overwrites the selected area with random data. Multiple passes are normally unnecessary on modern drives."
msgstr "Écrase la zone sélectionnée avec des données aléatoires. Plusieurs passes sont généralement inutiles sur les disques modernes."

