#: lib/driveutility.py:512
#, python-brace-format
msgid ""
"The device <b>{device}</b> is currently mounted and in use.\n"
"\n"
"Performing '<b>{operation}</b>' operation on a mounted device can result in:\n"
"  • Data loss\n"
"  • System instability\n"
"  • File system corruption\n"
"\n"
"Are you sure you want to continue?"
msgstr ""
"Das Gerät <b>{device}</b> ist derzeit eingehängt und in Benutzung.\n"
"\n"
"Das Ausführen der Operation '<b>{operation}</b>' auf einem eingehängten Gerät kann zu Folgendem führen:\n"
"  • Datenverlust\n"
"  • Systeminstabilität\n"
"  • Dateisystembeschädigung\n"
"\n"
"Sind Sie sicher, dass Sie fortfahren möchten?"

#: lib/driveutility.py:527
msgid "_Cancel"
msgstr "_Abbrechen"

#: lib/driveutility.py:529
msgid "C_ontinue"
msgstr "F_ortfahren"

#: lib/driveutility.py:774
msgid "Uses the drive controller to securely erase the drive without a full host-side overwrite."
msgstr "Verwendet den Laufwerkscontroller, um das Laufwerk sicher zu löschen, ohne dass ein vollständiges Überschreiben durch den Host erfolgt."

#: lib/driveutility.py:775
msgid "Discards all blocks quickly without overwriting the SSD. Use Secure erase when data must be unrecoverable."
msgstr "Verwirft alle Blöcke schnell, ohne die SSD zu überschreiben. Verwenden Sie 'Sicheres Löschen', wenn Daten unwiederbringlich entfernt werden müssen."

#: lib/driveutility.py:776
msgid "Overwrites the selected area with zeros. This is suitable for hard disks but causes unnecessary SSD writes."
msgstr "Überschreibt den ausgewählten Bereich mit Nullen. Dies ist für Festplatten geeignet, verursacht jedoch unnötige Schreibvorgänge auf SSDs."

#: lib/driveutility.py:777
msgid "Overwrites the selected area with random data. Multiple passes are normally unnecessary on modern drives."
msgstr "Überschreibt den ausgewählten Bereich mit Zufallsdaten. Mehrfache Durchläufe sind bei modernen Laufwerken normalerweise nicht erforderlich."

