#: lib/driveutility.py:512
#, python-brace-format
msgid ""
"The device <b>{device}</b> is currently mounted and in use.\n"
"\n"
"Performing '<b>{operation}</b>' operation on a mounted device can result in:\n"
"  • Data loss\n"
"  • System instability\n"
"  • File system corruption\n"
"\n"
"Are you sure you want to continue?"
msgstr ""
"O dispositivo <b>{device}</b> está atualmente montado e em uso.\n"
"\n"
"Executar a operação '<b>{operation}</b>' em um dispositivo montado pode resultar em:\n"
"  • Perda de dados\n"
"  • Instabilidade do sistema\n"
"  • Corrupção do sistema de arquivos\n"
"\n"
"Tem certeza de que deseja continuar?"

#: lib/driveutility.py:527
msgid "_Cancel"
msgstr "_Cancelar"

#: lib/driveutility.py:529
msgid "C_ontinue"
msgstr "C_ontinuar"

#: lib/driveutility.py:774
msgid "Uses the drive controller to securely erase the drive without a full host-side overwrite."
msgstr "Utiliza a controladora do drive para apagar o drive com segurança, sem sobrescrever totalmente pelo lado do host."

#: lib/driveutility.py:775
msgid "Discards all blocks quickly without overwriting the SSD. Use Secure erase when data must be unrecoverable."
msgstr "Descarta todos os blocos rapidamente sem sobrescrever o SSD. Use Apagamento seguro quando os dados precisarem ser irrecuperáveis."

#: lib/driveutility.py:776
msgid "Overwrites the selected area with zeros. This is suitable for hard disks but causes unnecessary SSD writes."
msgstr "Sobrescreve a área selecionada com zeros. Isso é adequado para discos rígidos, mas causa gravações desnecessárias em SSDs."

#: lib/driveutility.py:777
msgid "Overwrites the selected area with random data. Multiple passes are normally unnecessary on modern drives."
msgstr "Sobrescreve a área selecionada com dados aleatórios. Várias passagens normalmente não são necessárias em drives modernos."

