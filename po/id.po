#: lib/driveutility.py:512
#, python-brace-format
msgid ""
"The device <b>{device}</b> is currently mounted and in use.\n"
"\n"
"Performing '<b>{operation}</b>' operation on a mounted device can result in:\n"
"  • Data loss\n"
"  • System instability\n"
"  • File system corruption\n"
"\n"
"Are you sure you want to continue?"
msgstr ""
"Perangkat <b>{device}</b> saat ini sedang ter-mount dan digunakan.\n"
"\n"
"Melakukan operasi '<b>{operation}</b>' pada perangkat yang ter-mount dapat menyebabkan:\n"
"  • Kehilangan data\n"
"  • Ketidakstabilan sistem\n"
"  • Kerusakan sistem file\n"
"\n"
"Apakah Anda yakin ingin melanjutkan?"

#: lib/driveutility.py:527
msgid "_Cancel"
msgstr "_Batal"

#: lib/driveutility.py:529
msgid "C_ontinue"
msgstr "L_anjutkan"

#: lib/driveutility.py:774
msgid "Uses the drive controller to securely erase the drive without a full host-side overwrite."
msgstr "Menggunakan controller drive untuk menghapus drive secara aman tanpa penimpaan penuh dari sisi host."

#: lib/driveutility.py:775
msgid "Discards all blocks quickly without overwriting the SSD. Use Secure erase when data must be unrecoverable."
msgstr "Menghapus semua blok dengan cepat tanpa menimpa SSD. Gunakan Secure erase jika data harus benar-benar tidak dapat dipulihkan."

#: lib/driveutility.py:776
msgid "Overwrites the selected area with zeros. This is suitable for hard disks but causes unnecessary SSD writes."
msgstr "Menimpa area yang dipilih dengan nol. Cocok untuk hard disk, namun menyebabkan penulisan SSD yang tidak perlu."

#: lib/driveutility.py:777
msgid "Overwrites the selected area with random data. Multiple passes are normally unnecessary on modern drives."
msgstr "Menimpa area yang dipilih dengan data acak. Beberapa kali penimpaan biasanya tidak diperlukan pada drive modern."

