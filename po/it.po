#: lib/driveutility.py:512
#, python-brace-format
msgid ""
"The device <b>{device}</b> is currently mounted and in use.\n"
"\n"
"Performing '<b>{operation}</b>' operation on a mounted device can result in:\n"
"  • Data loss\n"
"  • System instability\n"
"  • File system corruption\n"
"\n"
"Are you sure you want to continue?"
msgstr ""
"Il dispositivo <b>{device}</b> è attualmente montato e in uso.\n"
"\n"
"Eseguire l'operazione '<b>{operation}</b>' su un dispositivo montato può causare:\n"
"  • Perdita di dati\n"
"  • Instabilità del sistema\n"
"  • Corruzione del file system\n"
"\n"
"Sei sicuro di voler continuare?"

#: lib/driveutility.py:527
msgid "_Cancel"
msgstr "_Annulla"

#: lib/driveutility.py:529
msgid "C_ontinue"
msgstr "C_ontinua"

#: lib/driveutility.py:774
msgid "Uses the drive controller to securely erase the drive without a full host-side overwrite."
msgstr "Utilizza il controller dell’unità per cancellare in modo sicuro il disco senza una sovrascrittura completa dal lato host."

#: lib/driveutility.py:775
msgid "Discards all blocks quickly without overwriting the SSD. Use Secure erase when data must be unrecoverable."
msgstr "Elimina rapidamente tutti i blocchi senza sovrascrivere l’SSD. Usa la cancellazione sicura se i dati devono essere irrecuperabili."

#: lib/driveutility.py:776
msgid "Overwrites the selected area with zeros. This is suitable for hard disks but causes unnecessary SSD writes."
msgstr "Sovrascrive l’area selezionata con zeri. Adatto per hard disk, ma causa scritture inutili su SSD."

#: lib/driveutility.py:777
msgid "Overwrites the selected area with random data. Multiple passes are normally unnecessary on modern drives."
msgstr "Sovrascrive l’area selezionata con dati casuali. Più passaggi sono normalmente inutili sui dischi moderni."

